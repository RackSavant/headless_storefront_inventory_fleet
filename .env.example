# All optional. The app runs fully offline with none of these set.

# Inventory source: json (data/inventory.json) or firestore. Falls back to JSON if Firestore fails.
INVENTORY_SOURCE=json
FIREBASE_PROJECT_ID=
# Service-account JSON as one line, or use GOOGLE_APPLICATION_CREDENTIALS=/path/key.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_INVENTORY_COLLECTION=inventory
# Optional: only load docs where owner_id == this (the Android app's signed-in owner)
FIRESTORE_OWNER_ID=
FIRESTORE_OWNER_FIELD=owner_id
INVENTORY_REFRESH_SECONDS=30

# Tripo image -> 3D (npm run tripo:generate). Defaults to the v2 OpenAPI base URL.
TRIPO_API_KEY=
TRIPO_BASE_URL=

# Where shopper profiles + events live: firestore | mongo | file (default: mongo if MONGODB_URI is set, else file)
STORE_BACKEND=

# Persist shopper profiles + events to MongoDB Atlas instead of ./.data
MONGODB_URI=
MONGODB_DB=racksavant_store

# Claude polishes look descriptions and parses free-text occasions ("beach wedding in May").
# Optional: `ant auth login` (OAuth, no key) also works. The harness's "Run with Claude"
# falls back to this machine's Claude Code login when neither is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# A World Labs Marble world (.spz) to use as the store backdrop instead of the built-in room
NEXT_PUBLIC_STORE_WORLD_SPZ=

# Photoreal AI try-on (Gemini image model, same API as the spatialintelligence repo)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image
