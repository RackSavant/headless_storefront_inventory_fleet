# All optional. The app runs fully offline with none of these set.

# Persist shopper profiles + events to MongoDB Atlas instead of ./.data
MONGODB_URI=
MONGODB_DB=racksavant_store

# Claude polishes look descriptions and parses free-text occasions ("beach wedding in May")
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# A World Labs Marble world (.spz) to use as the store backdrop instead of the built-in room
NEXT_PUBLIC_STORE_WORLD_SPZ=
